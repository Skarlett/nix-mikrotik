{ pkgs, lib, evalMikrotik, render, menus, example, typed }:

# The typed menu options and `mikrotik.sections` are two spellings of one value.
#
# Nothing here tests RouterOS syntax -- `tests/render.nix` does that, against a
# golden file. This tests the one claim the typed layer makes: that the spelling
# cannot change what is rendered, and that a menu name that does not exist is an
# evaluation error rather than a script the router rejects at import.
let
  inherit (lib) concatStringsSep filter length removePrefix splitString;

  mkSecret = name: { __mikrotikSecret = name; };

  # The option path a menu is written at, derived here from the menu path rather
  # than imported from `modules/menus.nix`: a test that reuses the implementation
  # it tests only proves the implementation is self-consistent.
  segmentsOf = m: splitString " " (removePrefix "/" m.path);
  hasChildren = m: lib.any (o: o.path != m.path && lib.hasPrefix "${m.path} " o.path) menus;
  accessPath = m: segmentsOf m ++ lib.optional (hasChildren m) "items";

  setPath = path: value: lib.setAttrByPath path value;

  probeBody = m: if m.kind == "list" then [ { probe = "1"; } ] else { probe = "1"; };
  probeVerb = m: if m.kind == "list" then "add probe=1" else "set probe=1";

  # ---------------------------------------------------------------- fixtures --
  #
  # One small router, twice: a list menu, a `set` menu, a secret, and the two
  # menus the convention has to carry (`/interface wireguard` and its peers).
  head = {
    hostname = "parity";
    sectionOrder = [ "/interface wireguard" "/ip address" ];
    secrets.wg-key = { };
  };

  asSections = { ... }: {
    mikrotik = head // {
      sections = {
        "/interface wireguard" = [
          { name = "wg0"; listen-port = 51820; mtu = 1420; private-key = mkSecret "wg-key"; }
        ];
        "/interface wireguard peers" = [
          { interface = "wg0"; name = "peer1"; public-key = "abc="; allowed-address = "0.0.0.0/0"; }
        ];
        "/ip address" = [
          { address = "10.0.0.3/24"; interface = "vlan10"; network = "10.0.0.0"; }
        ];
        "/ip dhcp-server" = [
          { name = "dhcp1"; interface = "vlan20"; address-pool = "dhcp_pool0"; disabled = false; }
        ];
        "/ip dhcp-server network" = [
          { address = "172.29.82.0/24"; gateway = "172.29.82.1"; dns-server = "1.1.1.1,8.8.8.8"; }
        ];
        "/ip dns" = {
          no_label = { allow-remote-requests = true; servers = "1.1.1.1"; };
        };
        "/ip service" = {
          ftp = { disabled = true; };
          ssh = { vrf = "vrf.mgmt"; };
        };
      };
    };
  };

  asMenus = { ... }: {
    mikrotik = head // {
      interface.wireguard.items = [
        { name = "wg0"; listen-port = 51820; mtu = 1420; private-key = mkSecret "wg-key"; }
      ];
      interface.wireguard.peers = [
        { interface = "wg0"; name = "peer1"; public-key = "abc="; allowed-address = "0.0.0.0/0"; }
      ];
      ip.address = [
        { address = "10.0.0.3/24"; interface = "vlan10"; network = "10.0.0.0"; }
      ];
      ip."dhcp-server".items = [
        { name = "dhcp1"; interface = "vlan20"; address-pool = "dhcp_pool0"; disabled = false; }
      ];
      ip."dhcp-server".network = [
        { address = "172.29.82.0/24"; gateway = "172.29.82.1"; dns-server = "1.1.1.1,8.8.8.8"; }
      ];
      ip.dns.items = {
        no_label = { allow-remote-requests = true; servers = "1.1.1.1"; };
      };
      ip.service = {
        ftp = { disabled = true; };
        ssh = { vrf = "vrf.mgmt"; };
      };
    };
  };

  sectionsScript = render (evalMikrotik { modules = [ asSections ]; });
  menusScript = render (evalMikrotik { modules = [ asMenus ]; });

  # A path written both ways merges, the way two `sections` definitions always
  # have. Definitions merge in reverse module order and `modules/menus.nix` is
  # part of the class, so a typed menu's lines come after the `sections` lines
  # for the same path. Pinned here rather than left implicit: migrating a menu
  # must not move its lines within the section.
  hybrid = render (evalMikrotik {
    modules = [
      { mikrotik.ip.address = [ { address = "10.0.0.2/24"; interface = "from-typed"; } ]; }
      { mikrotik.sections."/ip address" = [ { address = "10.0.0.1/24"; interface = "from-sections"; } ]; }
    ];
  });

  hybridExpected = ''
    # Generated by nix-mikrotik -- do not edit.
    /system identity
    set name="MikroTik"
    /ip address
    add address=10.0.0.1/24 interface=from-sections
    add address=10.0.0.2/24 interface=from-typed
  '';

  # A menu nobody set must not exist: `sections."/ip address" = [ ]` renders a
  # bare menu header, and the typed layer's defaults must not.
  minimal = render (evalMikrotik { modules = [ ]; });

  minimalExpected = ''
    # Generated by nix-mikrotik -- do not edit.
    /system identity
    set name="MikroTik"
  '';

  # `tryEval` catches `throw`, which is what both the module system's "option
  # does not exist" and this class' failed assertions are.
  failsToEvaluate = expr: !(builtins.tryEval (builtins.deepSeq expr null)).success;

  menuTypoCaught = failsToEvaluate (render (evalMikrotik {
    modules = [ { mikrotik.ip."dhcp-servr".network = [ { address = "10.0.0.0/24"; } ]; } ];
  }));

  attributeTypoCaught = failsToEvaluate (render (evalMikrotik {
    modules = [ { mikrotik.ip.address = [ { adress = "10.0.0.3/24"; } ]; } ];
  }));

  # ... and the escape hatch works, for a real RouterOS attribute the table has
  # not caught up with.
  attributeCheckOff = render (evalMikrotik {
    modules = [
      { mikrotik.checkMenuAttributes = false; }
      { mikrotik.ip.address = [ { adress = "10.0.0.3/24"; } ]; }
    ];
  });

  # Every menu in the table: reachable at its own attribute path, and compiled to
  # its own section key with the verb its `kind` promises.
  probes = map
    (m: {
      name = m.path;
      ok =
        let script = render (evalMikrotik {
              modules = [
                { mikrotik.checkMenuAttributes = false; }
                { mikrotik = setPath (accessPath m) (probeBody m); }
              ];
            });
        in lib.hasInfix "\n${m.path}\n" script && lib.hasInfix "\n${probeVerb m}\n" script;
    })
    menus;

  checks = [
    {
      name = "the typed example renders the section example byte for byte";
      ok = render typed == render example;
    }
    {
      name = "the same router written both ways renders identically";
      ok = sectionsScript == menusScript;
    }
    {
      name = "a typed menu merges after a section for the same path";
      ok = hybrid == hybridExpected;
    }
    {
      name = "unset menus add no section header";
      ok = minimal == minimalExpected;
    }
    {
      name = "a misspelt menu path is an evaluation error";
      ok = menuTypoCaught;
    }
    {
      name = "a misspelt attribute name is an evaluation error";
      ok = attributeTypoCaught;
    }
    {
      name = "mikrotik.checkMenuAttributes = false writes the attribute unchecked";
      ok = lib.hasInfix "\nadd adress=10.0.0.3/24\n" attributeCheckOff;
    }
    {
      name = "every menu path begins with a slash";
      ok = lib.all (m: lib.hasPrefix "/" m.path) menus;
    }
    {
      name = "no menu path has a trailing space or a doubled space";
      ok = lib.all (m: m.path == "/" + concatStringsSep " " (segmentsOf m)) menus;
    }
    {
      name = "no menu is declared twice";
      ok = length (map (m: m.path) menus) == length (lib.unique (map (m: m.path) menus));
    }
    {
      name = "no segment is named `items`, which the convention reserves";
      ok = lib.all (m: !(lib.elem "items" (segmentsOf m))) menus;
    }
    {
      name = "every menu declares a kind the module knows";
      ok = lib.all (m: lib.elem m.kind [ "list" "object" ]) menus;
    }
    {
      name = "no menu declares an empty attribute list";
      ok = lib.all (m: m.attrs == null || m.attrs != [ ]) menus;
    }
    {
      name = "/system identity is not a menu (it is mikrotik.hostname)";
      ok = !(lib.elem "/system identity" (map (m: m.path) menus));
    }
  ]
  ++ map (p: { name = "menu ${p.name} is reachable and renders its own section"; ok = p.ok; }) probes;

  failures = map (c: c.name) (filter (c: !c.ok) checks);
in
if failures != [ ]
then
  throw ''
    nix-mikrotik: typed menu tests failed:
    ${concatStringsSep "\n" (map (f: "  - ${f}") failures)}
  ''
else
  pkgs.runCommand "check-menus" { } ''
    mkdir -p $out

    # The list of what was checked, for the build log and for the pull request.
    cp ${pkgs.writeText "checks.txt" (lib.concatStringsSep "\n" (map
      (c: "${if c.ok then "ok  " else "FAIL"} ${c.name}")
      checks))} $out/checks.txt
    cat $out/checks.txt
    [ "$(grep -c '^ok' $out/checks.txt)" = "${toString (length checks)}" ]

    # The two spellings, on disk, diffed: the same comparison the assertion above
    # makes, in a form that prints a diff when it breaks.
    cp ${pkgs.writeText "sections.rsc" sectionsScript} $out/sections.rsc
    cp ${pkgs.writeText "menus.rsc" menusScript} $out/menus.rsc
    diff -u $out/sections.rsc $out/menus.rsc

    cp ${pkgs.writeText "typed-example.rsc" (render typed)} $out/typed-example.rsc
    cp ${pkgs.writeText "section-example.rsc" (render example)} $out/section-example.rsc
    diff -u $out/section-example.rsc $out/typed-example.rsc

    touch $out/pass
  ''