{ pkgs, render, legacy, example }:

# The renderer is the one piece that must not drift: a RouterOS script that
# changes shape between two versions of this tool is a router that changes
# behaviour.
#
# Two halves, answering different questions:
#
#   * tests/golden/legacy-upstream.rsc was produced by *upstream's* generator
#     over upstream's own example (tests/golden/README.md has the command and
#     the hashes). This renderer is not byte-identical to it -- four deviations,
#     listed there -- so the check asserts three of them by name, drops what
#     they account for (`/system identity`, comment lines) and diffs the rest.
#     Every `add`/`set` line, in order, must be exactly upstream's: that is the
#     cross-implementation half.
#   * tests/golden/legacy.rsc is this renderer's own output, committed: a
#     self-snapshot, so a refactor cannot move our bytes unnoticed.
pkgs.runCommand "check-render" { } ''
  mkdir -p $out

  cp ${pkgs.writeText "legacy.rsc" (render legacy)} $out/legacy.rsc
  diff -u ${./golden/legacy.rsc} $out/legacy.rsc
  cp ${./golden/legacy-upstream.rsc} $out/legacy-upstream.rsc

  # The three shape deviations (tests/golden/README.md):
  # (1) header, (2) identity first with a quoted value, (3) a final newline.
  [ "$(sed -n 1p $out/legacy.rsc)" = "# Generated by nix-mikrotik -- do not edit." ]
  [ "$(sed -n 2p $out/legacy.rsc)" = "/system identity" ]
  [ "$(sed -n 3p $out/legacy.rsc)" = 'set name="nidas"' ]
  [ "$(tail -c1 $out/legacy.rsc | od -An -tx1 | tr -d ' \n')" = "0a" ]
  # upstream's file ends on the `o` of `enabled=no`: deviation (3) is real, and
  # a fixture that quietly gained a newline must not pass.
  [ "$(tail -c1 $out/legacy-upstream.rsc | od -An -tx1 | tr -d ' \n')" = "6f" ]

  # (4) the rest of the file. Drop what the deviations account for -- the
  # `/system identity` section (two lines) and comment lines -- from both sides;
  # what is left has to be identical, line for line.
  body() { awk '$0 == "/system identity" { skip = 1; next } skip { skip = 0; next } /^#/ { next } { print }' "$1"; }
  body $out/legacy-upstream.rsc > upstream-body
  body $out/legacy.rsc > our-body
  diff -u upstream-body our-body
  cp upstream-body our-body $out/

  cp ${pkgs.writeText "module.rsc" (render example)} $out/module.rsc

  # A secret is a placeholder in the store, never a value.
  grep -q 'private-key=__MIKROTIK_SECRET_wg-private-key__' $out/module.rsc
  grep -q 'passphrase=__MIKROTIK_SECRET_wifi-password__' $out/module.rsc

  # sectionOrder puts the bridge before anything that references it.
  bridge_line=$(grep -n '^/interface bridge' $out/module.rsc | cut -d: -f1)
  address_line=$(grep -n '^/ip address' $out/module.rsc | cut -d: -f1)
  [ "$bridge_line" -lt "$address_line" ]

  # Booleans render the way RouterOS spells them, not the way Nix does.
  grep -q 'disabled=no' $out/module.rsc
  ! grep -q 'disabled=false' $out/module.rsc

  # A value RouterOS cannot parse unquoted is quoted; one it can, is not.
  # `public-key=<base64>=` broke an import at "expected end of command".
  grep -q 'public-key="l0VH8y3T0nKzZ9Qq2m4Xo8b1y6wR5cJ7dE3fG9hI2kA="' $out/module.rsc
  grep -q 'address=10.10.10.1/24' $out/module.rsc

  # ... and inside a quoted value, `"`, `\` and `$` are escaped (the example's
  # NAT comment carries a `$`). The pattern is shell-quoted; grep -F reads it as
  # bytes, so `\$` here is the backslash and dollar in the file.
  grep -qF 'comment="masquerade (cost \$5/GB)"' $out/module.rsc

  # The hardening module composed with the example rather than replacing it.
  grep -q '^/tool mac-server ping' $out/module.rsc
  grep -q 'allowed-interface-list=none' $out/module.rsc

  touch $out/pass
''