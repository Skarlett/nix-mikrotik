/ip firewall nat
add action=masquerade chain=srcnat comment="masquerade (cost \$5/GB)" out-interface-list=WAN
/interface wifi security
add authentication-types=wpa2-psk name=default passphrase=__MIKROTIK_SECRET_wifi-password/passphrase__
/interface wireguard
add listen-port=57676 mtu=1420 name=wg.luninet private-key=__MIKROTIK_SECRET_wg-private-key/privkey__
